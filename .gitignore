# Build outputs
target/
node_modules/
schemas/

# Sidecar binaries (fetched by scripts/pre_build.py)
desktop/src-tauri/binaries/

# Models and recordings — never committed
*.bin
*.wav
*.opus

# Compiled binaries and archives
*.exe
*.dll
