!desktop/src-tauri/windows/vcredist/*.dll
*.dylib
*.7z
*.xz

# Signing material
*.pfx

# Generated i18n state
**/project.inlang/cache/
**/project.inlang/project_id

# Local env, logs, OS/tool noise
.env
*trace*.log
.DS_Store
*.pyc
venv/
.superpowers/
